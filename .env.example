# LLM: auto picks Groq (if key) → Ollama (if running) → local tools (no key, free)
LLM_PROVIDER=auto

# Free cloud LLM (no credit card): https://console.groq.com/keys
GROQ_API_KEY=
# Free/dev tier models (llama-3.3-70b-versatile retired Aug 2026):
# openai/gpt-oss-20b | openai/gpt-oss-120b | qwen/qwen3-32b
GROQ_MODEL=openai/gpt-oss-20b

# Optional fully local LLM (install Ollama, then: ollama pull llama3.1)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Optional paid provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Paths (defaults work for local run)
DATABASE_URL=sqlite:///./data/hr.db
POLICIES_DIR=./data/policies
CHROMA_DIR=./data/chroma

# API
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
